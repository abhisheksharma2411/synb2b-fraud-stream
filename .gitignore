.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
scikit_learn_data/

# Credentials. Nothing here should ever exist; if it does, it must not be pushed.
*.pem
*.key
.env
.env.*
kaggle.json
credentials.json
secrets.*

.DS_Store
